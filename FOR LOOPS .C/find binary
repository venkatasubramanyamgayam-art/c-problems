#include <stdio.h>
#include <math.h>

int main() {
    long long binary;
    int decimal = 0, remainder, i;
 printf("Enter a binary number: ");
    scanf("%lld", &binary);
 for(i = 0; binary != 0; i++) 
        remainder = binary % 10;          
        decimal += remainder * pow(2, i); 
        binary /= 10;                     
      printf("Decimal equivalent: %d\n", decimal);
  return 0;
}
