#include <stdio.h>

int main() {
    int N;
  int errors;
    int total_errors;
 int critical_hours = 0;
 scanf("%d", &N);
 for(int i = 0; i < N; i++) {
scanf("%d", &errors);
total_errors += errors;
if(errors> 50) {
  critical_hours++;
 }
}
printf("total_errors: %d\n", total_errors);
printf("critical_hours: %d\n",critical_hours);

    return 0;
}
