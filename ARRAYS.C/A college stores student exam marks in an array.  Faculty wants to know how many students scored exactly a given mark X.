#include <stdio.h>
int main()
{
int n, i, x;
int count = 0;
printf("Enter number of students: ");
scanf("%d", &n);
int marks[n];
printf("Enter marks:\n");
for(i = 0; i < n; i++)
{
scanf("%d", &marks[i]);
}
printf("Enter mark to count: ");
scanf("%d", &x);
for(i = 0; i < n; i++)
{
if(marks[i] == x)
{
count++;
}
}
printf("Number of students scoring %d = %d", x, count);

    return 0;
}
