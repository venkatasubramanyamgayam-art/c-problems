#include <stdio.h>
int main() {
int N, i = 0;
int usage, maxUsage = -1, surgeHours = 0;
scanf("%d", &N);
  while (i < N) {
scanf("%d", &usage);
if (usage > maxUsage) {
maxUsage = usage;
}
if (usage > 5) {
surgeHours++;
}
i++;
}
printf("Max Usage: %d\n", maxUsage);
printf("Surge Hours: %d\n", surgeHours);

return 0;
}
