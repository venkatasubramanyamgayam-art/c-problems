#include <stdio.h>
int main() {
int capacity, N;
scanf("%d", &capacity);
scanf("%d", &N);
int change, i = 0;
int occupied = 0;
int criticalCount = 0;
int threshold = capacity * 0.9;
while(i < N) {
scanf("%d", &change);
occupied += change;
if(occupied > threshold)
criticalCount++;
i++;
}printf("Final Occupied Beds: %d\n", occupied);
printf("Critical Hours: %d\n", criticalCount);

    return 0;
}
