#include <stdio.h>
int main() {
int maxWeight, N;
scanf("%d", &maxWeight);
scanf("%d", &N);
int weight, i = 0;
int totalWeight = 0, passengers = 0;
int overload = 0;
while(i < N) {
scanf("%d", &weight);
if(totalWeight + weight > maxWeight) {
overload = 1;
break;
}totalWeight += weight;
passengers++;
i++;
}printf("Passengers Allowed: %d\n", passengers);
if(overload)
printf("Overload: Yes\n");
else
printf("Overload: No\n");

return 0;
}
