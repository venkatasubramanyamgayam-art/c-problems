#include <stdio.h>
int main() {
int dataPack, N, i = 0;
int usage;
int exhaustedDay = 0;
scanf("%d", &dataPack);
scanf("%d", &N);
while (i < N) {
scanf("%d", &usage);
dataPack -= usage;
i++;
if (dataPack <= 0) {
exhaustedDay = i;
break;
}
}
if (exhaustedDay == 0) {
printf("Exhausted Day: Not Exhausted\n");
printf("Overused Data: 0\n");
} else {
int overused = (dataPack < 0) ? -dataPack : 0;
printf("Exhausted Day: %d\n", exhaustedDay);
printf("Overused Data: %d\n", overused);
    }
return 0;
}
