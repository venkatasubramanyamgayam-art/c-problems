
#include <stdio.h>
int main() {
int N;
scanf("%d", &N);
int status, i = 0;
int currentStreak = 0, maxStreak = 0;
while(i < N) {
scanf("%d", &status);
if(status == 0) {
currentStreak++;
if(currentStreak > maxStreak)
maxStreak = currentStreak;
} else {
currentStreak = 0;
}
i++;
}
printf("Longest Failure Streak: %d\n", maxStreak);

    return 0;
}
