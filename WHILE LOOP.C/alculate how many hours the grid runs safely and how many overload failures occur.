#include <stdio.h>
int main() {
int capacity, N;
int load[100];
int i = 0;
int safeHours = 0, failureCount = 0;
scanf("%d", &capacity);
scanf("%d", &N);
for(int j = 0; j < N; j++) {
scanf("%d", &load[j]);
}
while(i < N) {
if(load[i] <= capacity) {
safeHours++;
} else {
failureCount++;
}
i++;
}
printf("Safe Hours: %d\n", safeHours);
printf("Failure Count: %d\n", failureCount);

    return 0;
}
