#include <stdio.h>
int main() {
int n;
scanf("%d", &n);
int calls[n];
int totalCalls = 0, overloadedHours = 0;
for(int i = 0; i < n; i++) {
scanf("%d", &calls[i]);
    }
for(int i = 0; i < n; i++) {
totalCalls += calls[i];
if(calls[i] > 40) {
overloadedHours++;
        }
    }  printf("Total Calls: %d\n", totalCalls);
    printf("Overloaded Hours: %d\n", overloadedHours);

    return 0;
}
