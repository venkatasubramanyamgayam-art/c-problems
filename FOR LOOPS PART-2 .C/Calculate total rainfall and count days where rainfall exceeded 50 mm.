#include <stdio.h>

int main() {
    int N;
    int rainfall;
    int total_rainfall = 0;
    int heavy_rain_days = 0;
 scanf("%d", &N);
 for(int i = 0; i < N; i++) {
scanf("%d", &rainfall);
total_rainfall += rainfall;
if(rainfall > 50) {
  heavy_rain_days++;
 }
}
printf("Total Rainfall: %d\n", total_rainfall);
printf("Heavy Rain Days: %d\n", heavy_rain_days);

    return 0;
}
