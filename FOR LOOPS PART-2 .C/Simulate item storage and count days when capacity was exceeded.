#include <stdio.h>
int main() {
int capacity, n;
scanf("%d", &capacity);
scanf("%d", &n);
int items[n];
int overflowDays = 0;
for(int i = 0; i < n; i++) {
scanf("%d", &items[i]);
    }
for(int i = 0; i < n; i++) {
capacity -= items[i];
if(capacity < 0) {
overflowDays++;
        }
    }
  printf("Remaining Capacity: %d\n", capacity);
    printf("Overflow Days: %d\n", overflowDays);
 return 0;
}
