#include <stdio.h>
int main() {
int N;
scanf("%d", &N);
int heartRate[N];
int maxRate = 0;
int dangerCount = 0;
for(int i = 0; i < N; i++) {
scanf("%d", &heartRate[i]);
if(i == 0 || heartRate[i] > maxRate) {
maxRate = heartRate[i];
        }
if(heartRate[i] > 140) {
dangerCount++;
        }
    }
printf("Max Heart Rate: %d\n", maxRate);
printf("Danger Readings: %d\n", dangerCount);

    return 0;
}
