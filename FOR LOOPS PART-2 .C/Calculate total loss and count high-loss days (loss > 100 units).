#include <stdio.h>

int main() {
    int N;
    int units;
    int total_Loss = 0;
    int High_Loss_Days= 0;
 scanf("%d", &N);
 for(int i = 0; i < N; i++) {
scanf("%d", &units);
total_Loss += units;
if(units > 100) {
  High_Loss_Days++;
        }
    }printf("Total loss: %d\n", total_Loss);
printf("Heavy Loss Days: %d\n", High_Loss_Days);

    return 0;
}
