#include <stdio.h>

int main() {
int n;
scanf("%d", &n);
int units[n];
int totalUnits = 0, spikeHours = 0;
for(int i = 0; i < n; i++) {
scanf("%d", &units[i]);
    }
for(int i = 0; i < n; i++) {
totalUnits += units[i];
if(units[i] > 5) {
spikeHours++;
        }
    } printf("Total Units: %d\n", totalUnits);
    printf("Spike Hours: %d\n", spikeHours);

    return 0;
}
